# ============================================================
#  PORTFOLIO EMAIL CONFIGURATION  —  COPY THIS FILE TO .env.local
# ============================================================
#
#  MY EMAIL GOES HERE  ->  the inbox that receives contact messages:
CONTACT_EMAIL=YOUR_EMAIL_HERE

# ------------------------------------------------------------
# SMTP settings (works with Gmail App Password, Outlook, Zoho…)
#
# For GMAIL:
#   1. Enable 2-Step Verification on your Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password below
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_EMAIL_HERE
SMTP_PASS=YOUR_APP_PASSWORD_OR_SECRET_KEY
